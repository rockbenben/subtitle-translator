{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Subtitle Translator",
  "mainBinaryName": "SubtitleTranslator",
  "version": "3.1.1",
  "identifier": "com.rockbenben.subtitletranslator",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Subtitle Translator",
        "url": "/en/",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 832,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https: http:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
      "devCsp": null,
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Batch subtitle & document translator",
    "longDescription": "Translate subtitles and documents in batches across many languages as a native desktop app. The UI and your files stay on your machine; translation itself is sent to the AI/MT provider you configure and needs network access.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rockbenben/subtitle-translator/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBM0FEMzc1RDdFMDc1MzIKUldReWRlRFhkZE02aXBkTXR4cE9VcTM3U1hSaWpsdWRCUDFoclkzdDBtSTVGMEJRaDB2TWRvNGsK"
    }
  }
}
